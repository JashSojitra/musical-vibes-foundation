{
  "name": "musical-vibes-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "assets:collect": "python scripts/collect_legacy.py",
    "assets:audit": "node scripts/audit-images.mjs",
    "assets:curate": "node scripts/curate-images.mjs",
    "assets:curate:release2": "node scripts/curate-release2.mjs",
    "test:browser": "playwright test",
    "verify:routes": "node scripts/verify-release2.mjs",
    "format:check": "prettier --check src tests playwright.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:workers": "node scripts/test-workers.mjs",
    "cf:tail": "wrangler tail",
    "validate:ci": "node scripts/validate-ci.mjs",
    "cf:build:demo": "node scripts/build-demo.mjs",
    "cf:preview:demo": "opennextjs-cloudflare preview --config wrangler.demo.jsonc",
    "cf:deploy:demo": "opennextjs-cloudflare deploy --config wrangler.demo.jsonc",
    "test:cms": "tsx --test tests-cms/*.test.ts",
    "test:owner-preview": "node scripts/test-owner-preview.mjs",
    "test:studio-upload": "node scripts/test-story-upload.mjs",
    "sanity:migrate:dry": "tsx scripts/sanity-migration.ts --dry-run",
    "sanity:migrate:write": "tsx scripts/sanity-migration.ts --write",
    "sanity:migrate:verify": "tsx scripts/sanity-migration.ts --verify",
    "studio:build": "npm --prefix studio run build",
    "studio:validate": "npm --prefix studio run schema:validate",
    "cf:build:cms-preview": "node scripts/build-cms-preview.mjs",
    "cf:validate:cms-preview": "node scripts/validate-cms-preview.mjs",
    "cf:preview:cms-preview": "node scripts/run-cms-preview.mjs preview",
    "cf:dry-run:cms-preview": "node scripts/run-cms-preview.mjs dry-run",
    "cf:deploy:cms-preview": "node scripts/run-cms-preview.mjs deploy",
    "test:cms-preview": "playwright test --config playwright.cms-preview.config.ts",
    "test:cms-preview:live": "playwright test --config playwright.cms-preview-live.config.ts",
    "sanity:audit:public": "node scripts/audit-sanity-public.mjs",
    "sanity:repair": "tsx scripts/sanity-repair.ts",
    "production:content:plan": "tsx scripts/production-content-audit.ts",
    "test:production-plan": "node --test tests-cms/production-plan.test.mjs tests-cms/production-tsx.test.mjs",
    "cf:build:production": "node scripts/build-production.mjs",
    "cf:dry-run:production": "node scripts/run-production.mjs dry-run",
    "cf:deploy:production": "node scripts/run-production.mjs deploy",
    "photos:recover": "node scripts/recover-photos.mjs",
    "photos:plan": "node scripts/photo-import-plan.mjs",
    "test:photo-recovery": "node --test tests-cms/photo-recovery.test.mjs",
    "photos:import": "tsx scripts/historical-import.ts",
    "sanity:cleanup": "tsx scripts/historical-cleanup.ts",
    "test:historical-import": "tsx --test tests-cms/historical-import.test.mjs tests-cms/historical-import-cli.test.ts"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "rclone.js": "0.6.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@opennextjs/cloudflare": {
      "glob": "14.0.3"
    },
    "@node-minify/core": {
      "glob": "14.0.3"
    },
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  },
  "engines": {
    "node": ">=22.14.0 <25"
  }
}
