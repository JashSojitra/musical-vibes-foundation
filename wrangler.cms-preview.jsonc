{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musical-vibes-foundation-cms-preview",
  "main": "cloudflare/cms-preview-worker.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": { "directory": ".open-next-cms-preview/assets", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "vars": {
    "DEPLOYMENT_ENV": "cms-preview",
    "CONTENT_SOURCE": "sanity",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "6jpdhhxg",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2026-11-01"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true
}
